<?xml version="1.0"?>
<!DOCTYPE workflow
[
	<!-- Whether to run the transfer job for derecho (via globus) -->
	<!ENTITY TRANSFER_DERECHO_ON "true">
	<!-- Whether to run the transfer job for AWS S3 -->
	<!ENTITY TRANSFER_AWS_ON "true">

	<!-- Root directory for the filter_dump package -->
	<!ENTITY SCRIPT_DIR "/scratch3/NAGAPE/epic/Walter.Kolczynski/save/filter_dump">

	<!-- Source location for dump data -->
	<!ENTITY DUMP_SOURCE "/scratch3/NCEPDEV/global/role.glopara/dump">
	<!-- Output location for local santized dump -->
	<!ENTITY OUT_DIR "/scratch3/NAGAPE/epic/Walter.Kolczynski/noscrub">
	<!-- Temporary location for IODA conversion -->
	<!ENTITY IODA_TMP "/scratch3/NAGAPE/epic/Walter.Kolczynski/noscrub/stmp/obsForge">

	<!-- Target URI for AWS S3 bucket -->
	<!ENTITY AWS_TARGET "s3://noaa-epic-global-release-pds">
	<!-- Name of the profile with the correct AWS credential -->
	<!ENTITY AWS_PROFILE "epic">
	<!-- Ursa globus ID (established by RDHPCS, should not need to be changed) -->
	<!ENTITY URSA_GLOBUS_ID "8bbc822a-a625-4058-b68e-65edacd73828">
	<!-- Derecho globus ID (established by user, point share to root global shared directory) -->
	<!ENTITY DERECHO_GLOBUS_ID "aa1e0f82-1bb9-4e0a-acfd-69e1ccc72ce0">
	
	<!-- Rocoto workflow control -->
	<!ENTITY PSLOT "filter_dump">
	<!ENTITY CYCLE_THROTTLE "2">
	<!ENTITY TASK_THROTTLE "40">
	<!ENTITY MAXTRIES "1">

	<!-- Job scheduler settings -->
	<!ENTITY ACCOUNT "epic">
	<!ENTITY SCHEDULER "slurm">
	<!ENTITY COMPUTE_QUEUE "batch">
	<!ENTITY TRANSFER_QUEUE "batch">
	<!ENTITY COMPUTE_PART "u1-compute">
	<!ENTITY TRANSFER_PART "u1-service">
]>

<workflow realtime="F" cyclethrottle="&CYCLE_THROTTLE;" scheduler="&SCHEDULER;" taskthrottle="&TASK_THROTTLE;">

	<log><cyclestr>&OUT_DIR;/filter_dump_logs/@Y@m@d_@H/filter_dump.log</cyclestr></log>
	
	<!-- List as many different cycles definitions as needed -->
	<cycledef group="dump">202601010000 202601010000 06:00:00</cycledef>

<!-- 	<cycledef group="dump">202103241200 202103250000 06:00:00</cycledef>
	<cycledef group="dump">202112201200 202112221800 06:00:00</cycledef>
	<cycledef group="dump">202205150600 202205151800 06:00:00</cycledef>
	<cycledef group="dump">202304011800 202304020000 06:00:00</cycledef>
	<cycledef group="dump">202402231800 202402240600 06:00:00</cycledef> -->

	<task name="make_nr_dump" cycledefs="dump" maxtries="&MAXTRIES;">
		<jobname><cyclestr>merge_@Y@m@d_@H</cyclestr></jobname>
		<account>&ACCOUNT;</account>
		<join><cyclestr>&OUT_DIR;/filter_dump_logs/@Y@m@d_@H/make_nr_dump.log</cyclestr></join>
		<walltime>03:00:00</walltime>
		<queue>&COMPUTE_QUEUE;</queue>
		<partition>&COMPUTE_PART;</partition>
		<nodes>1:ppn=1:tpp=1</nodes>
		<memory>4048M</memory>

		<command><cyclestr>&SCRIPT_DIR;/make_nr_dump.sh &DUMP_SOURCE; &OUT_DIR;/dump_nr @Y@m@d @H</cyclestr></command>
	</task>
